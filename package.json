{
  "name": "omp-conductor",
  "version": "0.1.0",
  "description": "My oh-my-pi (omp) harness in one command: a curated collection of public plugins and skills, my Jev router, and switchable Claude / ChatGPT / mixed model setups.",
  "keywords": ["omp", "oh-my-pi", "omp-plugin", "pi-package", "jev", "typesafe", "model-router", "claude", "codex"],
  "license": "MIT",
  "author": {
    "name": "hsmoviich",
    "url": "https://github.com/hsmoviich"
  },
  "homepage": "https://github.com/hsmoviich/omp-conductor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsmoviich/omp-conductor.git"
  },
  "bugs": {
    "url": "https://github.com/hsmoviich/omp-conductor/issues"
  },
  "type": "module",
  "bin": {
    "omp-conductor": "bin/omp-conductor.mjs"
  },
  "files": [
    "bin/",
    "extensions/",
    "agents/",
    "profiles.json",
    "skills.json",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": ["./extensions/jev-router.ts", "./extensions/conductor.ts"]
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
